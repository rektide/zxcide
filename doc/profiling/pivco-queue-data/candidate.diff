+#[test]
+fn queue_reuse_recovers_from_partial_runs_and_late_validation() {
+    use crate::wire::{FrameHeader, MAGIC, block_header, header_sum};
+    let mut frame = [0; 16];
+    frame[..4].copy_from_slice(&MAGIC);
+    frame[4..7].copy_from_slice(&[9, 12, 128]); // checksummed
+    let sum = header_sum(&frame);
+    frame[14..].copy_from_slice(&sum.to_le_bytes());
+    let frame = FrameHeader::parse(frame).unwrap();
+    let make = |table: &[u8; 128], run: &[u8], plain: &[u8]| {
+        let mut body = vec![0; 4];
+        body.extend_from_slice(&(plain.len() as u32).to_le_bytes());
+        body.extend_from_slice(&[2, 0, 0, 0]);
+        body.extend_from_slice(&((table.len() + run.len()) as u32).to_le_bytes());
+        body.extend_from_slice(table);
+        body.extend_from_slice(run);
+        body.resize(body.len() + 32, 0);
+        let header = DataBlockHeader::parse(block_header(1, body.len() as u32), frame).unwrap();
+        body.extend_from_slice(&checksum(plain, 0).to_le_bytes());
+        (header, body)
+    };
+    let mut mixed = [0; 128];
+    mixed[32..35].copy_from_slice(&[0x20, 0x22, 0x33]); // A/B/C: 2, D/E: 3
+    let mut shorter = [0; 128];
+    shorter[44] = 0x11; // X/Y: 1
+    let mut unary = [0; 128];
+    unary[44] = 1; // X only
+    let sample = b"ACBDACBEACBDACBE";
+    let mut worker = BlockDecoder::default();
+    let (h, b) = make(&mixed, &[0xaa, 0xaa, 0xaa, 0xaa, 0x0a], sample);
+    assert_eq!(worker.decode(h, &b, None, 0, None).unwrap().bytes, sample);
+    assert!(worker.sections.queue.capacity() > 0);
+    for (table, run, plain, error) in [
+        // Root consumes the two bytes; left is a short flat run and right is still queued.
+        (&mixed, &[0xaa, 0xaa][..], &sample[..], "short section"),
+        (&mixed, &[0xaa, 0xaa, 0xaa, 0xaa, 0x0a, 0][..], &sample[..], "trailing Huffman data"),
+        (&unary, &[1][..], &b"X"[..], "Huffman run selects missing child"),
+        (&shorter, &[0][..], &b""[..], "trailing Huffman data"),
+    ] {
+        let (h, b) = make(table, run, plain);
+        let e = worker.decode(h, &b, None, 0, None).unwrap_err();
+        assert_eq!(e.kind(), io::ErrorKind::InvalidData);
+        assert_eq!(e.to_string(), error);
+        assert_eq!(worker.sections.queue.capacity(), 0);
+        let (h, b) = make(&shorter, &[2], b"XYX");
+        assert_eq!(worker.decode(h, &b, None, 0, None).unwrap().bytes, b"XYX");
+    }
+    let (h, b) = make(&shorter, &[], b"");
+    assert_eq!(worker.decode(h, &b, None, 0, None).unwrap().bytes, b"");
+    let (h, mut b) = make(&shorter, &[2], b"XYX");
+    assert_eq!(worker.decode(h, &b, None, 0, Some(2)).unwrap_err().to_string(), "unexpected decoded block size");
+    assert!(worker.sections.queue.is_empty() && worker.sections.queue.capacity() > 0);
+    *b.last_mut().unwrap() ^= 1;
+    assert_eq!(worker.decode(h, &b, None, 0, None).unwrap_err().to_string(), "block checksum mismatch");
+    assert!(worker.sections.queue.is_empty() && worker.sections.queue.capacity() > 0);
+    let (h, b) = make(&shorter, &[1], b"YX");
+    worker.sections.queue.reserve_exact(32);
+    let plain = worker.decode_owned(h, b, None, 0).unwrap().into_buffer();
+    assert_eq!(plain, b"YX");
+    assert_eq!(worker.sections.queue.capacity(), 0);
+}
