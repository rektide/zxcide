+//! Linux diagnostic overlay only. No clock calls, TLS or atomics in clean builds.
+use rustix::time::{ClockId, clock_gettime};
+use std::{
+    cell::Cell,
+    sync::atomic::{AtomicU64, Ordering::Relaxed},
+    time::Instant,
+};
+
+#[derive(Clone, Copy)]
+pub(super) enum Phase {
+    Data,
+    Marker,
+    Finish,
+    Prologue,
+    PhysicalEof,
+    Stable,
+}
+const LABELS: [&str; 6] = ["data", "marker", "finish", "prologue", "physical_eof", "stable"];
+const ZERO: [u64; 3] = [0; 3];
+thread_local! {
+    static COORD: Cell<[[u64; 3]; 6]> = const { Cell::new([ZERO; 6]) };
+    static BODY: Cell<u64> = const { Cell::new(0) };
+    static WORK: Cell<[u64; 3]> = const { Cell::new(ZERO) };
+}
+static WORK_SUM: [AtomicU64; 3] = [const { AtomicU64::new(0) }; 3];
+
+fn cpu() -> u64 {
+    let t = clock_gettime(ClockId::ThreadCPUTime);
+    t.tv_sec as u64 * 1_000_000_000 + t.tv_nsec as u64
+}
+
+pub(super) struct Clock(Instant, u64);
+impl Clock {
+    pub(super) fn start() -> Self {
+        Self(Instant::now(), cpu())
+    }
+    pub(super) fn stop(self) -> Sample {
+        let cpu = cpu() - self.1;
+        Sample(cpu, self.0.elapsed().as_nanos() as u64)
+    }
+}
+
+pub(super) struct Sample(u64, u64);
+impl Sample {
+    pub(super) fn add(self, phase: Phase) {
+        COORD.with(|c| {
+            let mut all = c.get();
+            let t = &mut all[phase as usize];
+            t[0] += 1;
+            t[1] += self.0;
+            t[2] += self.1;
+            c.set(all);
+        });
+    }
+}
+
+pub(super) fn caller_body(size: usize) {
+    BODY.with(|n| n.set(n.get() + size as u64));
+}
+pub(super) fn worker_job(positioned_body: Option<usize>) {
+    WORK.with(|w| {
+        let [jobs, headers, body] = w.get();
+        w.set([
+            jobs + 1,
+            headers + 8 * u64::from(positioned_body.is_some()),
+            body + positioned_body.unwrap_or(0) as u64,
+        ]);
+    });
+}
+pub(super) struct WorkerBatch;
+impl Drop for WorkerBatch {
+    fn drop(&mut self) {
+        for (sum, n) in WORK_SUM.iter().zip(WORK.with(Cell::get)) {
+            sum.fetch_add(n, Relaxed);
+        }
+    }
+}
+
+/// Single CLI operation, called after the writer/transaction completed.
+pub fn emit() {
+    let all = COORD.with(Cell::get);
+    if all[Phase::Prologue as usize][0] == 0 {
+        return;
+    }
+    let data_jobs = all[Phase::Data as usize][0];
+    let frame_markers = all[Phase::Marker as usize][0];
+    let [wj, wh, wb] = WORK_SUM.each_ref().map(|n| n.load(Relaxed));
+    eprint!(
+        "ZXC_POSITIONED_PROBE jobs={data_jobs} caller_data_header_bytes={} caller_marker_bytes={} caller_body_bytes={} worker_jobs={wj} worker_header_bytes={wh} worker_body_bytes={wb}",
+        data_jobs * 8,
+        frame_markers * 8,
+        BODY.with(Cell::get)
+    );
+    for (label, [calls, cpu, wall]) in LABELS.into_iter().zip(all) {
+        eprint!(" {label}={calls},{cpu},{wall}");
+    }
+    eprintln!();
+}
