+        assert_eq!(
+            body_range(u64::MAX - 8, header, u64::MAX).unwrap_err().kind(),
+            io::ErrorKind::InvalidData
+        );
+        assert_eq!(
+            body_range(u64::MAX - header.disk_size() as u64, header, u64::MAX)
+                .unwrap()
+                .1,
+            u64::MAX
+        );
+    }
+}
