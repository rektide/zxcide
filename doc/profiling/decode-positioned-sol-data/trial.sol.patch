+//! Scratch experiment: front-to-back header discovery, scoped worker body reads.
+use super::{Config, channel, decode_channel_from};
+use std::{
+    fs::{File, Metadata},
+    io::{self, Read, Write},
+    os::unix::fs::{FileExt, MetadataExt},
+};
+use zxc_codec::{
+    DecodeOptions,
+    stream::classify_block_header,
+    wire::{BLOCK_HEADER_SIZE, DataBlockHeader, FrameHeader},
+};
+
+struct Cursor<'a> {
+    file: &'a File,
+    pos: u64,
+    end: u64,
+}
+
+fn invalid(message: &'static str) -> io::Error {
+    io::Error::new(io::ErrorKind::InvalidData, message)
+}
+
+fn add(pos: u64, len: usize) -> io::Result<u64> {
+    u64::try_from(len)
+        .ok()
+        .and_then(|len| pos.checked_add(len))
+        .ok_or_else(|| invalid("positioned input range overflow"))
+}
+
+impl Read for Cursor<'_> {
+    fn read(&mut self, dst: &mut [u8]) -> io::Result<usize> {
+        let remain = self
+            .end
+            .checked_sub(self.pos)
+            .ok_or_else(|| invalid("position beyond end"))?;
+        let len = dst.len().min(usize::try_from(remain).unwrap_or(usize::MAX));
+        if len == 0 {
+            return Ok(0);
+        }
+        let next = add(self.pos, len)?;
+        self.file.read_exact_at(&mut dst[..len], self.pos)?;
+        self.pos = next;
+        Ok(len)
+    }
+}
+
+struct Job {
+    settings: FrameHeader,
+    raw: [u8; BLOCK_HEADER_SIZE],
+    offset: u64,
+    stop: u64,
+}
+
+fn body_range(offset: u64, header: DataBlockHeader, end: u64) -> io::Result<(u64, u64)> {
+    let start = add(offset, BLOCK_HEADER_SIZE)?;
+    let stop = add(start, header.body_size())?;
+    if stop > end {
+        return Err(io::Error::new(
+            io::ErrorKind::UnexpectedEof,
+            "short positioned block body",
+        ));
+    }
+    Ok((start, stop))
+}
+
+fn admit(cursor: &mut Cursor<'_>, settings: FrameHeader, _buf: &mut Vec<u8>) -> io::Result<Option<Job>> {
+    let offset = cursor.pos;
+    let mut raw = [0; BLOCK_HEADER_SIZE];
+    cursor.read_exact(&mut raw)?;
+    let Some(header) = classify_block_header(raw, settings)? else {
+        return Ok(None);
+    };
+    let (_, stop) = body_range(offset, header, cursor.end)?;
+    cursor.pos = stop;
+    Ok(Some(Job {
+        settings,
+        raw,
+        offset,
+        stop,
+    }))
+}
+
+fn materialize(file: &File, end: u64, job: Job, mut buf: Vec<u8>) -> io::Result<(DataBlockHeader, Vec<u8>)> {
+    if add(job.offset, BLOCK_HEADER_SIZE)? > end {
+        return Err(invalid("positioned block header outside input"));
+    }
+    let mut raw = [0; BLOCK_HEADER_SIZE];
+    file.read_exact_at(&mut raw, job.offset)?;
+    if raw != job.raw {
+        return Err(invalid("positioned block header changed"));
+    }
+    let header =
+        classify_block_header(raw, job.settings)?.ok_or_else(|| invalid("unexpected positioned EOF header"))?;
+    let (start, stop) = body_range(job.offset, header, end)?;
+    if stop != job.stop {
+        return Err(invalid("positioned block extent changed"));
+    }
+    zxc_codec::resize_zero!(buf, header.body_size());
+    file.read_exact_at(&mut buf, start)?;
+    Ok((header, buf))
+}
+
+fn stamp(meta: &Metadata) -> (u64, i64, i64, i64, i64) {
+    (
+        meta.len(),
+        meta.mtime(),
+        meta.mtime_nsec(),
+        meta.ctime(),
+        meta.ctime_nsec(),
+    )
+}
+
+fn check_stable(file: &File, opening: &Metadata) -> io::Result<()> {
+    if stamp(&file.metadata()?) != stamp(opening) {
+        return Err(invalid("positioned input changed during decode"));
+    }
+    Ok(())
+}
+
+pub(super) fn decode(
+    file: &File,
+    opening: &Metadata,
+    w: impl Write,
+    options: DecodeOptions<'_>,
+    config: Config,
+) -> io::Result<()> {
+    let end = opening.len();
+    decode_channel_from(
+        channel::Driver::<channel::Crossbeam>::new(config),
+        Cursor { file, pos: 0, end },
+        w,
+        options,
+        admit,
+        |job, buf| materialize(file, end, job, buf),
+    )?;
+    check_stable(file, opening)
+}
