+#[test]
+fn inline_canonical_matches_old_tree_for_generated_shapes_and_corruption() {
+    fn draw(state: &mut u32) -> usize {
+        *state = state.wrapping_mul(1664525).wrapping_add(1013904223);
+        (*state >> 8) as usize
+    }
+    let mut rng = 0x35c0_5d6b;
+    let (mut out, mut scratch) = (Vec::new(), Vec::new());
+    for shape in 0..600 {
+        let mut lengths = vec![0];
+        let n = 2 + draw(&mut rng) % 255;
+        while lengths.len() < n {
+            let i = draw(&mut rng) % lengths.len();
+            if lengths[i] < 11 {
+                lengths[i] += 1;
+                lengths.push(lengths[i]);
+            }
+        }
+        if shape < 8 {
+            lengths = vec![shape as u8 + 1; 2 << shape];
+        }
+        let mut order: Vec<_> = (0..=255u8).collect();
+        for i in (1..order.len()).rev() {
+            order.swap(i, draw(&mut rng) % (i + 1));
+        }
+        let mut table = [0u8; 128];
+        for (&sym, depth) in order.iter().zip(&lengths) {
+            table[sym as usize / 2] |= depth << (4 * (sym % 2));
+        }
+        let tree = Tree::new(&table).unwrap();
+        let count = 1 + draw(&mut rng) % 400;
+        let input: Vec<_> = (0..count)
+            .map(|i| {
+                if i < lengths.len() {
+                    order[i]
+                } else {
+                    order[draw(&mut rng) % lengths.len()]
+                }
+            })
+            .collect();
+        let mut freq = [0; 256];
+        for &s in &input {
+            freq[s as usize] += 1;
+        }
+        let bits = tree.emit(&input, &freq, &[], usize::MAX).unwrap();
+        assert_eq!(
+            decode_inline(&table, &bits, count, &mut out, &mut scratch).unwrap(),
+            input
+        );
+        let mut trailing = bits.clone();
+        trailing.push(0xff);
+        let mut changed = bits.clone();
+        let i = draw(&mut rng) % bits.len();
+        changed[i] ^= 1 << (draw(&mut rng) % 8);
+        for run in [&bits[..bits.len() - 1], &trailing, &changed] {
+            let old = tree.decode(run, count).map_err(|e| (e.kind(), e.to_string()));
+            let new = decode_inline(&table, run, count, &mut out, &mut scratch)
+                .map(<[u8]>::to_vec)
+                .map_err(|e| (e.kind(), e.to_string()));
+            assert_eq!(old, new, "shape={shape}");
+        }
+    }
+}
