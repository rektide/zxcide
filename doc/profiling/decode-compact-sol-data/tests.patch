+#[test]
+fn inline_canonical_wire_and_errors() {
+    let (mut out, mut scratch) = (Vec::new(), Vec::new());
+    let mut decode = |table: &[u8; 128], src: &[u8], count| {
+        decode_inline(table, src, count, &mut out, &mut scratch).map(<[u8]>::to_vec)
+    };
+    let mut table = [0; 128];
+    // B=10, C=110, D=111 under a uniform root; set high padding.
+    table[32..35].copy_from_slice(&[0x10, 0x32, 0x03]);
+    let wire = [0xff, 0xf6, 0xfe];
+    assert_eq!(decode(&table, &wire, 5).unwrap(), b"BCDBD");
+    for n in 0..wire.len() {
+        assert_eq!(decode(&table, &wire[..n], 5).unwrap_err().to_string(), "short section");
+    }
+    assert_eq!(
+        decode(&table, &[0xff, 0xf6, 0xfe, 0], 5).unwrap_err().to_string(),
+        "trailing Huffman data"
+    );
+    assert!(decode(&table, &[], 0).unwrap().is_empty());
+    assert_eq!(
+        decode(&table, &[0], 0).unwrap_err().to_string(),
+        "trailing Huffman data"
+    );
+
+    table.fill(0);
+    table[127] = 0x10;
+    assert_eq!(decode(&table, &[0, 0xfe], 9).unwrap(), [255; 9]);
+    assert_eq!(
+        decode(&table, &[0, 0xff], 9).unwrap_err().to_string(),
+        "Huffman run selects missing child"
+    );
+    assert_eq!(decode(&table, &[0], 9).unwrap_err().to_string(), "short section");
+    for (first, last, error) in [
+        (0, 0, "incomplete Huffman tree"),
+        (2, 0, "incomplete Huffman tree"),
+        (0x11, 0x10, "incomplete Huffman tree"),
+        (0xc1, 0, "Huffman length exceeds 11"),
+        (12, 0, "Huffman length exceeds 11"),
+    ] {
+        table[0] = first;
+        table[127] = last;
+        assert_eq!(decode(&table, &[], 0).unwrap_err().to_string(), error);
+    }
+}
